@model ProductCatalog.Models.Product

<div class="card mb-3 shadow-sm">
    <div class="card-header @(Model.IsAvailable ? "bg-success text-white" : "bg-danger text-white")">
        <h5 class="mb-0">@Model.Name</h5>
    </div>
    <div class="card-body">
        <p class="card-text"><strong>Санат:</strong> @Model.Category</p>
        <p class="card-text"><strong>Бағасы:</strong> @Model.Price.ToString("N0") тг</p>

        @if (Model.IsAvailable)
        {
            <span class="badge bg-primary">Сатылымда бар</span>
        }
        else
        {
            <span class="badge bg-secondary">Қолда жоқ</span>
        }
    </div>
</div>