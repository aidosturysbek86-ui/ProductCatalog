@model IEnumerable<ProductCatalog.Models.Product>

@{
    ViewData["Title"] = "Тауарлар каталогы";
}

<h1 class="my-4">Тауарлар каталогы</h1>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4">
            <!-- Жасаған Partial View-ді осында шақырамыз -->
            <partial name="_ProductCard" model="product" />
        </div>
    }
</div>